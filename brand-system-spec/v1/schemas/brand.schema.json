{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cscgeneration.local/brand-system/v1/brand.schema.json",
  "title": "Brand package entrypoint",
  "type": "object",
  "required": ["schemaVersion", "packageVersion", "brand", "files", "modules", "provenance"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "packageVersion": { "type": "string" },
    "brand": {
      "type": "object",
      "required": ["id", "name", "description", "proposition", "audiences", "traits"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "proposition": { "type": "string" },
        "audiences": { "type": "array", "items": { "type": "string" } },
        "traits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "files": { "type": "object" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "path"],
        "properties": {
          "capability": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "provenance": { "type": "object" }
  }
}
